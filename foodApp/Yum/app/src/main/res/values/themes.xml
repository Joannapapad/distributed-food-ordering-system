<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Yum" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brown</item>
        <item name="android:windowBackground">@color/beige</item>
        <item name="android:popupBackground">@color/beige</item>
        <item name="colorOnBackground">@color/brown</item>
        <item name="colorSurface">@color/beige</item>
        <item name="colorOnSurface">@color/brown</item>
        <item name="android:textColorHighlight">@color/lightBrown</item>
        <item name="colorControlActivated">@color/brown</item>
        <item name="android:textColorPrimary">@color/brown</item>
        <item name="android:textColorSecondary">@color/brown</item>\
        <item name="colorControlNormal">@color/brown</item>

    </style>

    <style name="YumAlertDialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:background">@color/beige</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/YumDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/YumDialogButton</item>
    </style>

    <style name="YumDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/red</item>
    </style>


    <style name="Theme.Yum" parent="Base.Theme.Yum" />

</resources>